<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chirp_surface_variant"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/contactsToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chirp_surface_variant"
        android:elevation="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:navigationIcon="@android:drawable/ic_media_previous"
        app:title="@string/contacts_title"
        app:subtitle="@string/contacts_subtitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/contactsSearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_field"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:minHeight="52dp"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp"
            android:textColor="@color/chirp_text_primary"
            android:textColorHint="@color/chirp_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addByPhoneButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/contacts_add_by_phone"
            android:textColor="@color/chirp_green_dark"
            app:icon="@android:drawable/ic_input_add"
            app:iconTint="@color/chirp_green_dark" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contactsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <LinearLayout
        android:id="@+id/contactsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contacts_empty_title"
            android:textColor="@color/chirp_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contactsEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/contacts_empty_subtitle"
            android:textColor="@color/chirp_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
