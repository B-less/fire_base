<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand Colors (Kept identical for brand consistency) -->
    <color name="chirp_blue">#1DA1F2</color>
    <color name="chirp_blue_dark">#0C85D0</color>
    <color name="chirp_blue_light">#E8F5FE</color>
    
    <color name="chirp_green">#25D366</color>
    <color name="chirp_green_dark">#1DAA61</color>
    <color name="chirp_green_light">#E9F9F0</color>

    <!-- Theme Colors -->
    <color name="colorPrimary">@color/chirp_blue</color>
    <color name="colorPrimaryDark">@color/chirp_blue_dark</color>
    <color name="colorAccent">@color/chirp_green</color>

    <!-- Surface & Backgrounds (Dark Mode Twitter/X Style) -->
    <color name="chirp_surface">#15202B</color> <!-- Deep blue-gray scaffold -->
    <color name="chirp_surface_variant">#192734</color> <!-- Slightly lighter for app bars/cards -->
    <color name="chirp_border">#38444D</color> <!-- Dark border -->
    <color name="chirp_scaffold">#15202B</color>
    
    <!-- Text Colors (Dark Mode) -->
    <color name="chirp_text_primary">#FFFFFF</color> <!-- Crisp White text -->
    <color name="chirp_text_secondary">#8899A6</color> <!-- Soft Gray for meta/time -->
    <color name="chirp_text_inverse">#14171A</color> <!-- Dark text if needed on light bg -->

    <!-- Message Bubbles (Dark Mode) -->
    <color name="chirp_sent_bubble">@color/chirp_blue</color> <!-- Sent stays brand blue -->
    <color name="chirp_sent_text">#FFFFFF</color> <!-- Sent text stays white -->
    <color name="chirp_received_bubble">#22303C</color> <!-- Received bubble is elevated dark surface -->
    <color name="chirp_received_text">#FFFFFF</color> <!-- Received text becomes white -->

    <!-- Navigation -->
    <color name="chirp_nav_selected">@color/chirp_blue</color>
    <color name="chirp_nav_unselected">#8899A6</color>

    <!-- Miscellaneous -->
    <color name="chirp_error">#E0245E</color>
    <color name="transparent">#00000000</color>
</resources>
